[gd_resource type="ShaderMaterial" load_steps=2 format=2]

[sub_resource type="Shader" id=5]
code = "shader_type canvas_item;

uniform vec4 target_color : hint_color = vec4(1.0, 0.0, 0.0, 1.0); // couleur à appliquer
uniform float strength : hint_range(0.0, 1.0) = 1.0;         // intensité de l’effet
uniform float lighten : hint_range(0.0, 1.0) = 0.2;

void fragment() {
    vec4 c = texture(TEXTURE, UV);

    float gray = dot(c.rgb, vec3(0.299, 0.587, 0.114));
    vec3 colored = mix(vec3(1.0), target_color.rgb, 1.0 - gray);
    vec3 result = mix(c.rgb, colored, strength);
	result = mix(result, vec3(1.0), lighten * (1.0 - strength));
	//result = result + lighten * (1.0 - strength);
	//result = clamp(result, 0.0, 1.0);
    COLOR = vec4(result, c.a);
}"

[resource]
shader = SubResource( 5 )
shader_param/target_color = Color( 0, 0, 0, 1 )
shader_param/strength = 0.0
shader_param/lighten = 0.5
