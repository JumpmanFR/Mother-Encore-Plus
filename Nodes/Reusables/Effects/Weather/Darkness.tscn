[gd_scene load_steps=4 format=2]

[ext_resource path="res://Scripts/misc/Darkness.gd" type="Script" id=1]

[sub_resource type="Shader" id=9]
code = "shader_type canvas_item;
render_mode unshaded;

uniform bool circle_visible = true;

uniform float minimumRadius : hint_range(0.0, 500.0) = 64;
uniform float outerRadius1 : hint_range(0.0, 500.0) = 16;
uniform float outerRadius2 : hint_range(0.0, 500.0) = 16;


uniform vec2 position = vec2(160, 90);
uniform vec2 offset = vec2(0, 0);
uniform vec2 textSize = vec2(320, 180);

uniform bool animated = false;
uniform float speed = 1.0;
uniform float time : hint_range(0.0, 1);
uniform float growPercent : hint_range(0.0, 1.0) = 0.5;

const float ONETHIRD = 1.0/3.0;

float ratio()
{
	return textSize.x / textSize.y;
}

float circle(vec2 uv, float rad, vec2 pos, vec2 off, float spd)
{
	float newTime = time * 3.14 * 2.0;
	if (animated) newTime += TIME;
	
	float radsize = rad / (textSize.y * 2.0);
	
	rad = radsize + radsize * growPercent * cos(newTime * spd);
	vec2 circlePosition =  vec2(mix(0.5, pos.x/(textSize.x), ratio()), pos.y/(textSize.y));
	vec2 circleOffset =  vec2(mix(0.0, off.x/(textSize.x), ratio()), off.y/(textSize.y));
	float dist = distance(circlePosition + circleOffset, vec2(mix(0.5, uv.x, ratio()) , uv.y ));
	return step(rad, dist);
}

void fragment()
{
	
	if (circle_visible)
	{
		float c1 = circle(UV, minimumRadius, position, offset, speed) * ONETHIRD;
		float c2 = circle(UV, minimumRadius + outerRadius1, position, -offset, -speed ) * ONETHIRD;
		float c3 = circle(UV, minimumRadius + outerRadius1 + outerRadius2, position, -offset, -speed ) * ONETHIRD;
		COLOR.a = COLOR.a * ( c2 + c1 + c3);
	}
}"

